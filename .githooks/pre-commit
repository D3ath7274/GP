#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
  python_command=python3
else
  python_command=python
fi
"$python_command" scripts/check_docs_sync.py --staged
"$python_command" scripts/check_feature_catalog.py --staged
exec "$python_command" scripts/build_ai_handoff.py --staged
