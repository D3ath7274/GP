alert icmp any any -> any any (msg:"ICMP Flood"; itype:8; detection_filter:track by_src, count 10, seconds 5; sid:1000001; rev:2;)
alert tcp any any -> any any (msg:"TCP Port Scan"; flags:S; detection_filter:track by_src, count 20, seconds 10; sid:1000002; rev:2;)
alert tcp any any -> any 22 (msg:"SSH Brute Force"; flags:S; detection_filter:track by_src, count 5, seconds 60; sid:1000003; rev:2;)
# OLD/WORKING-DRAFT VERSION: broad UDP flood rule. Disabled because the active VM rule targets DNS/53.
# alert udp any any -> any any (msg:"UDP Flood"; detection_filter:track by_src, count 20, seconds 5; sid:1000004; rev:1;)
alert udp any any -> any 53 (msg:"UDP Flood"; detection_filter:track by_src, count 20, seconds 5; sid:1000004; rev:1;)
alert tcp any any -> any 8080 (msg:"Ryu REST API TCP Flood"; flags:S; detection_filter:track by_src, count 20, seconds 5; sid:1000005; rev:1;)
